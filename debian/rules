export DH_VERBOSE = 1

# Require a full x.y.z version to avoid matching cmake_minimum_required(VERSION x.y).
SOVERSION := $(shell awk 'match($$0, /VERSION[[:space:]]+([0-9]+)\.[0-9]+\.[0-9]+/, a) { print a[1]; exit }' CMakeLists.txt)

# Use pre-fetched CPM sources when available, avoiding a network fetch.
# Fall back to allowing network access on a clean tree without a prior build.
SPDLOG_SRC := $(wildcard $(CURDIR)/build/_deps/spdlog-src)
TOMLPLUSPLUS_SRC := $(wildcard $(CURDIR)/build/_deps/tomlplusplus-src)
CPM_FLAGS := -DFETCHCONTENT_FULLY_DISCONNECTED=OFF
ifdef SPDLOG_SRC
CPM_FLAGS += -DFETCHCONTENT_SOURCE_DIR_SPDLOG=$(SPDLOG_SRC)
endif
ifdef TOMLPLUSPLUS_SRC
CPM_FLAGS += -DFETCHCONTENT_SOURCE_DIR_TOMLPLUSPLUS=$(TOMLPLUSPLUS_SRC)
endif

# Standalone target: regenerate debian/control after a major-version bump.
# Run manually: make -f debian/rules debian/control
debian/control: debian/control.in
	sed 's/@SOVERSION@/$(SOVERSION)/g' $< > $@

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DBUILD_EXAMPLES=ON \
		-DBUILD_TESTS=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		$(CPM_FLAGS)

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# Install the project license and third-party notices into every binary package.
override_dh_installdocs:
	dh_installdocs --all \
		LICENSE \
		compliance/THIRD_PARTY_NOTICES.md \
		compliance/manifest.tsv \
		compliance/licenses

# Generate the runtime library install list before dh_install reads it.
execute_before_dh_install:
	sed 's/@SOVERSION@/$(SOVERSION)/g' \
		debian/libstorage-lender-client.install.in \
		> debian/libstorage-lender-client$(SOVERSION).install

override_dh_clean:
	dh_clean
	rm -f debian/libstorage-lender-client[0-9]*.install
